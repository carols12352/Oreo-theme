{
	"name": "Oreo",
	"version": "1.4.2",
	"minAppVersion": "1.0.0",
	"author": "carols12352",
	"authorUrl": "https://github.com/carols12352",
	"scripts": {
		"version": "node version-bump.mjs",
		"bump": "bash scripts/bump-version.sh",
		"bump:patch": "bash scripts/bump-version.sh patch",
		"bump:minor": "bash scripts/bump-version.sh minor",
		"bump:major": "bash scripts/bump-version.sh major",
		"release:patch": "bash scripts/bump-version.sh patch --tag --push",
		"release:minor": "bash scripts/bump-version.sh minor --tag --push",
		"release:major": "bash scripts/bump-version.sh major --tag --push",
		"hooks:install": "bash scripts/install-git-hooks.sh"
	}
}
